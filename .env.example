# Copy to .env. Values in .env are local and ignored by Git.
JALSAKSHI_ENVIRONMENT=development
JALSAKSHI_TENANT_DATA_MODE=synthetic
# Used by migrations and database fixture scripts; never by the request-serving API.
JALSAKSHI_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
JALSAKSHI_SUPABASE_URL=https://PROJECT_REF.supabase.co
JALSAKSHI_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Required in production (e.g. Vercel): 32+ random chars, e.g. `openssl rand -hex 32`. Seals session cookies.
JALSAKSHI_SESSION_SECRET=
